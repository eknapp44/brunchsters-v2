# Brunchsters — Environment Variables
# Copy to apps/web/.env.local and fill in real values. Never commit .env.local.
# Prisma CLI vars (DATABASE_URL, DIRECT_URL) also go in packages/database/.env.
# Local values come from `supabase start` output. See docs/SETUP.md §5.

# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# Pooled connection for app runtime (via pgBouncer in prod, direct in local dev)
DATABASE_URL=""
# Direct connection for Prisma migrations (bypasses pooler)
DIRECT_URL=""

# ── Supabase ──────────────────────────────────────────────────────────────────
# From `supabase start` output
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── Auth (NextAuth / Auth.js) ─────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Base URL for auth callbacks — http://localhost:3000 locally
AUTH_URL=""

# ── Google OAuth (needed when reaching the auth spec) ────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Apple Sign-In (deferred — $99/year account, add near launch) ─────────────
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# ── Email — Resend ───────────────────────────────────────────────────────────
# Leave blank locally: emails are written to EMAIL_OUTBOX_DIR instead of being sent.
RESEND_API_KEY=""
# Sending address on your verified Resend domain, e.g. Brunchsters <invites@mail.example.com>.
# Unset = Resend's sandbox sender (delivers only to your own Resend account address). Required
# in a production deployment (VERCEL_ENV=production), where the sandbox sender cannot work.
EMAIL_FROM=""
# Local outbox for emails when RESEND_API_KEY is blank. Defaults to .mail-outbox/ (git-ignored).
EMAIL_OUTBOX_DIR=""

# ── Google Places API (Places API (New) + Time Zone API) ─────────────────────
# NOT the OAuth client credentials — a separate Maps Platform API key.
GOOGLE_PLACES_API_KEY="your_maps_api_key_here"

# ── Inngest async job queue ──────────────────────────────────────────────────
# Local: set INNGEST_DEV=1 and run the dev server (docs/SETUP.md); leave the two keys blank.
INNGEST_DEV=""
# Production only. A production deployment (VERCEL_ENV=production) will not start without them.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ── Token encryption — AES-256-GCM key for OAuth token storage ───────────────
# Generate with: openssl rand -base64 32
# WARNING: rotating this key invalidates all stored tokens. Never commit.
TOKEN_ENCRYPTION_KEY=""
