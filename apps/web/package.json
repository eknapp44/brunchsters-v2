{
  "name": "@brunchsters/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:queue": "npx --yes inngest-cli@1.46.0 dev --no-discovery -u http://localhost:3000/api/inngest",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e:db:reset": "tsx scripts/e2e-db-reset.ts",
    "test:e2e": "pnpm e2e:db:reset && playwright test",
    "screenshots": "node scripts/cleanScreenshots.mjs && pnpm e2e:db:reset && playwright test --config playwright.screenshots.config.ts",
    "boards": "tsx scripts/boards.ts",
    "shots:spec": "node scripts/specShots.mjs",
    "dev:as": "tsx scripts/devAs.ts"
  },
  "dependencies": {
    "@brunchsters/core": "workspace:*",
    "@brunchsters/database": "workspace:*",
    "@brunchsters/shared": "workspace:*",
    "@prisma/client": "6.19.3",
    "@reduxjs/toolkit": "^2.13.0",
    "inngest": "4.23.0",
    "next": "^15.5.28",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.3.0",
    "resend": "6.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "neverthrow": "^6.2.2",
    "tsx": "^4.22.4",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
